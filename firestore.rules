rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the user authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is the user an admin?
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper: is the user accessing their own data?
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // === ACCOUNTS ===
    // Users can only read/write their own account
    match /accounts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuth()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['pass', 'name', 'email'])
        && request.resource.data.pass is string
        && request.resource.data.pass.size() > 0
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*\\..*');
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // === USERS (game data) ===
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // === BANNED ===
    match /banned/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // === CONFIG ===
    match /config/{docId} {
      allow read: if false;
      allow write: if isAdmin();
    }
  }
}
