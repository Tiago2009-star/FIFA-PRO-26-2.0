<html>
<head>
<title>Fifarinhas 26 - Instalador</title>
<HTA:APPLICATION
  ID="FifarinhasInstaller"
  APPLICATIONNAME="Fifarinhas 26 Installer"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  ICON=""
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  VERSION="1.0"
  SCROLL="no"
/>
<style>
body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #1a1a2e; color: #ecf0f1; margin: 0; padding: 30px; overflow: hidden; }
.card { text-align: center; }
.logo { font-size: 3em; margin-bottom: 10px; }
h1 { font-size: 1.6em; font-weight: 800; margin-bottom: 4px; }
h1 span { color: #e94560; }
.sub { color: #7f8c8d; font-size: 0.85em; margin-bottom: 24px; }
.step { display: flex; align-items: flex-start; gap: 12px; padding: 12px; background: rgba(255,255,255,0.04); border: 1px solid #2a2a4a; border-radius: 10px; margin-bottom: 8px; text-align: left; }
.num { width: 28px; height: 28px; border-radius: 50%; background: #e94560; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85em; flex-shrink: 0; }
.step-text { font-size: 0.88em; line-height: 1.5; }
.step-text b { color: #f5a623; }
.btn { display: block; width: 100%; padding: 14px; border-radius: 12px; border: none; font-size: 1em; font-weight: 700; cursor: pointer; margin-top: 14px; font-family: inherit; }
.btn-green { background: #2ecc71; color: #fff; }
.btn-green:hover { opacity: 0.9; }
.btn-accent { background: #e94560; color: #fff; }
.btn-accent:hover { opacity: 0.9; }
.msg { margin-top: 14px; padding: 12px; border-radius: 10px; font-size: 0.88em; display: none; }
.msg-ok { background: rgba(46,125,50,0.15); border: 1px solid rgba(46,125,50,0.3); color: #2ecc71; }
.msg-err { background: rgba(233,69,96,0.15); border: 1px solid rgba(233,69,96,0.3); color: #e94560; }
.hidden { display: none; }
</style>
</head>
<body>
<div class="card">
  <div class="logo">⚽</div>
  <h1>FIFA<span>RINHAS</span> 26</h1>
  <div class="sub">Instalador — Mundial 2026</div>

  <div id="mainSection">
    <button class="btn btn-green" onclick="install()" id="installBtn">📦 Instalar Fifarinhas 26</button>
    <button class="btn btn-accent" onclick="openApp()" style="margin-top:8px;" id="openBtn>Abrir App no Navegador</button>
    <div class="msg msg-ok" id="msgOk"></div>
    <div class="msg msg-err" id="msgErr"></div>

    <div style="margin-top:20px; border-top:1px solid #2a2a4a; padding-top:16px;">
      <div class="step">
        <div class="num">1</div>
        <div class="step-text">Clica em <b>Instalar</b> — cria um atalho no Desktop</div>
      </div>
      <div class="step">
        <div class="num">2</div>
        <div class="step-text">Abre o atalho no Desktop para usar a app</div>
      </div>
      <div class="step">
        <div class="num">3</div>
        <div class="step-text">No Chrome/Edge, clica no ícone 📦 na barra de endereço para instalar como app</div>
      </div>
    </div>
  </div>
</div>

<script>
var appUrl = 'https://fifarinhas26.web.app/index.html';
var desktopPath = '';
var shell = null;

try {
  shell = new ActiveXObject('WScript.Shell');
  desktopPath = shell.SpecialFolders('Desktop');
} catch(e) {}

function showOk(msg) {
  var el = document.getElementById('msgOk');
  el.textContent = msg;
  el.style.display = 'block';
  document.getElementById('msgErr').style.display = 'none';
}

function showErr(msg) {
  var el = document.getElementById('msgErr');
  el.textContent = msg;
  el.style.display = 'block';
  document.getElementById('msgOk').style.display = 'none';
}

function install() {
  if (!shell) {
    showErr('Não foi possível aceder ao Windows Script Host.');
    return;
  }
  try {
    // 1. Criar atalho .url no Desktop
    var shortcutPath = desktopPath + '\\Fifarinhas 26.url';
    var fso = new ActiveXObject('Scripting.FileSystemObject');
    var f = fso.CreateTextFile(shortcutPath, true);
    f.WriteLine('[InternetShortcut]');
    f.WriteLine('URL=' + appUrl);
    f.WriteLine('IconIndex=0');
    f.Close();

    // 2. Criar script .vbs para instalar como app PWA
    var vbsPath = desktopPath + '\\Instalar-Fifarinhas-26.vbs';
    var vbs = fso.CreateTextFile(vbsPath, true);
    vbs.WriteLine('Set objShell = CreateObject("WScript.Shell")');
    vbs.WriteLine('objShell.Run "cmd /c start "" ""' + appUrl + '""", 0, False');
    vbs.Close();

    showOk('✅ Atalho criado no Desktop! Dá duplo-clique em "Fifarinhas 26" para abrir a app.');
  } catch(e) {
    showErr('Erro: ' + e.message);
  }
}

function openApp() {
  try {
    if (shell) {
      shell.Run('cmd /c start "" "' + appUrl + '"', 0, false);
    } else {
      window.open(appUrl, '_blank');
    }
  } catch(e) {
    window.open(appUrl, '_blank');
  }
}
</script>
</body>
</html>
